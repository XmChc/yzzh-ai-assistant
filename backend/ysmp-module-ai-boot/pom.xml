<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.ysmp</groupId>
        <artifactId>yzzh-ai-assistant-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>ysmp-module-ai-boot</artifactId>
    <packaging>jar</packaging>
    <name>ysmp-module-ai-boot</name>
    <description>AI 助手开箱模块：配置表、管理 API、OpenAPI 目录、默认安全适配占位</description>

    <dependencies>
        <dependency>
            <groupId>cn.ysmp</groupId>
            <artifactId>ysmp-spring-boot-starter-ai</artifactId>
            <!-- 显式版本，避免宿主 IDEA 未解析父 POM dependencyManagement 时丢掉传递依赖 -->
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- OpenAPI 模型（扫描本机文档，provided 由宿主 springdoc 提供亦可运行时反射） -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-models</artifactId>
            <version>2.2.28</version>
        </dependency>
        <!-- 可选：默认 PreAuthorize 权限解析；宿主无 Security 时走 NoOp -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
    </dependencies>
</project>
